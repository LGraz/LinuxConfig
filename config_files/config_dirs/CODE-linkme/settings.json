        "\\dsP": "{\\text{$\\mathbb{P}$}}",
        "\\dsE": "{\\text{$\\mathbb{E}$}}",
        "\\dsR": "{\\text{$\\mathbb{R}$}}",
        "\\dsN": "{\\text{$\\mathbb{N}$}}",
