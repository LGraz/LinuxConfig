        "\\logit": "\\operatorname{logit}",
        "\\probit": "\\operatorname{probit}",
        "\\expit": "\\operatorname{expit}",
        "\\loglog": "\\operatorname{loglog}",
        "\\cloglog": "\\operatorname{cloglog}",
