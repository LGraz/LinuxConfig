    "markdown.extension.katex.macros": {
        "\\R": "\\mathbb{R}",
        "\\sam": "{\\Omega}",
        "\\ps": "{(\\sam, \\sA, \\Prob)}",
        "\\vek": "{\\begin{pmatrix}#1\\\\#2\\end{pmatrix}}",
        "\\vekk": "{\\begin{pmatrix}#1\\\\#2\\end{pmatrix}}",
        "\\Darrow": "{\\stackrel{D}{\\longrightarrow}}",
        "\\Parrow": "{\\stackrel{\\Prob}{\\longrightarrow}}",
        "\\etc": "{\\textit{etc.}~}",
        "\\OR": "{\\text{OR}}",
        "\\nullvec": "{\\mathbf{0}}",
        "\\onevec": "{\\mathbf{1}}",
        "\\ubar": "\\underline ",
        "\\proglang": "\\textsf ",
        "\\pkg": "\\textbf ",
        "\\code": "\\texttt ",
        "\\comd": "\\texttt ",
        "\\indep": "{\\perp \\!\\!\\! \\perp}",
        // <!-- %%% mlt -->,
        // <!-- %% rv -->,
        "\\rZ": "{Z}",
        "\\rY": "{Y}",
        "\\rC": "{C}",
        "\\rX": "{\\mX}",
        "\\rz": "{z}",
        "\\ry": "{y}",
        "\\rc": "{c}",
        "\\rx": "{\\xvec}",
        "\\rs": "{\\upsilon}",
        "\\erx": "{x}",
        // <!-- %% sigma algebra -->,
        "\\sA": "{\\mathfrak{A}}",
        "\\sAZ": "{\\mathfrak{B}}",
        "\\sAY": "{\\mathfrak{C}}",
        "\\esA": "{\\mA}",
        "\\esAZ": "{\\mB}",
        "\\esAY": "{\\mC}",
        // <!-- %% sample spaces -->,
        "\\samZ": "{\\RR}",
        "\\samY": "{\\Xi}",
        "\\samX": "{\\chi}",
        // <!-- %% measureable spaces -->,
        "\\ms": "{(\\sam, \\sA)}",
        "\\msZ": "{(\\samZ, \\sAZ)}",
        "\\msY": "{(\\samY, \\sAY)}",
        // <!-- %% probability spaces -->,
        "\\psZ": "{(\\samZ, \\sAZ, \\Prob_\\rZ)}",
        "\\psY": "{(\\samY, \\sAY, \\Prob_\\rY)}",
        // <!-- %% distributions -->,
        "\\pZ": "{F_\\rZ}",
        "\\pY": "{F_\\rY}",
        "\\sY": "{S_\\rY}",
        "\\oY": "{O_\\rY}",
        "\\oYx": "{O_{\\rY \\mid \\rX = \\rx}}",
        "\\hatpY": "{\\hat{F}_{\\rY}}",
        "\\hath": "{\\hat{\\h}}",
        "\\hatpYx": "{\\hat{F}_{\\rY \\mid \\rX = \\rx}}",
        "\\pN": "{\\Phi}",
        "\\pSL": "{F_{\\SL}}",
        "\\pMEV": "{F_{\\MinEV}}",
        "\\pMax": "{F_{\\MaxEV}}",
        "\\pExp": "{F_{\\ExpD}}",
        "\\pSW": "{F_{\\SW}}",
        "\\pYx": "{F_{\\rY \\mid \\rX = \\rx}}",
        "\\pYnull": "{F_{\\rY \\mid \\rX = \\nullvec}}",
        "\\sYx": "{S_{\\rY \\mid \\rX = \\rx}}",
        "\\pYA": "{F_{\\rY \\mid \\rX = A}}",
        "\\pYB": "{F_{\\rY \\mid \\rX = B}}",
        "\\qZ": "{Q_\\rZ}",
        "\\qY": "{Q_\\rY}",
        "\\dZ": "{f_\\rZ}",
        "\\dY": "{f_\\rY}",
        "\\dmZ": "{f_\\mZ}",
        "\\dmY": "{f_\\mY}",
        "\\Fnul": "{F_0}",
        "\\Fone": "{F_1}",
        "\\Snul": "{S_0}",
        "\\Sone": "{S_1}",
        "\\Hnul": "{\\Lambda_0}",
        "\\Hone": "{\\Lambda_1}",
        "\\hnul": "{\\lambda_0}",
        "\\hone": "{\\lambda_1}",
        "\\hatFnul": "{\\hat{F}_0}",
        "\\hatFone": "{\\hat{F}_1}",
        "\\hatSnul": "{\\hat{S}_0}",
        "\\hatSone": "{\\hat{S}_1}",
        "\\hathnul": "{\\hat{\\lambda}_0}",
        "\\hathone": "{\\hat{\\lambda}_1}",
        "\\hatHnul": "{\\hat{\\Lambda}_0}",
        "\\hatHone": "{\\hat{\\Lambda}_1}",
        "\\hatdY": "{\\hat{f}_{\\rY}}",
        "\\dYx": "{f_{\\rY \\mid \\rX = \\rx}}",
        "\\hazY": "{\\lambda_\\rY}",
        "\\hazYx": "{\\lambda_{\\rY \\mid \\rX = \\rx}}",
        "\\hazYnull": "{\\lambda_{\\rY \\mid \\rX = 0}}",
        "\\HazY": "{\\Lambda_\\rY}",
        "\\HazYx": "{\\Lambda_{\\rY \\mid \\rX = \\rx}}",
        "\\hathazY": "{\\hat{\\lambda}_{\\rY}}",
        "\\hatHazY": "{\\hat{\\Lambda}_{\\rY}}",
        "\\Laplace": "{\\mathsf{L}}",
        // <!-- %% measures -->,
        "\\measureY": "{\\mu}",
        "\\lebesgue": "{\\mu_L}",
        "\\counting": "{\\mu_{\\#}}",
        // <!-- %% trafo -->,
        "\\g": "{g}",
        "\\h": "{h}",
        "\\s": "{\\svec}",
        "\\hY": "{h_\\rY}",
        "\\hx": "{h_\\rx}",
        "\\hs": "{\\mathcal{H}}",
        "\\basisy": "{\\avec}",
        "\\bern": "[1]{\\avec_{\\text{Bs},#1}}",
        "\\bernx": "[1]{\\bvec_{\\text{Bs},#1}}",
        "\\basisx": "{\\bvec}",
        "\\basisyx": "{\\cvec}",
        "\\m": "{m}",
        "\\lik": "{L_i}",
        "\\iidlik": "{L}",
        "\\logliki": "{\\ell_i}",
        "\\loglik": "{\\ell}",
        "\\rloglik": "{\\tilde{\\ell}}",
        "\\parm": "{\\varthetavec}",
        "\\eparm": "{\\vartheta}",
        "\\dimparm": "{P}",
        "\\dimparmx": "{Q}",
        "\\shiftparm": "{\\betavec}",
        "\\eshiftparm": "{\\beta}",
        "\\ie": "{\\textit{i.e.}~}",
        "\\eg": "{\\textit{e.g.}~}",
        "\\Prob": "{\\mathbb{P}}",
        "\\Ex": "{\\mathbb{E}}",
        "\\Cov": "{\\mathbb{V}}",
        "\\RR": "{\\mathbb{R}}",
        "\\NN": "{\\mathbb{N}}",
        "\\eps": "{\\varepsilon}",
        "\\prodname": "{tensor }",
        "\\Null": "{\\mathbf{0}}",
        "\\FI": "{\\mF}",
        "\\I": "{\\mathbb{1}}",
