    "notebook.output.fontSize": 16,
    "aws.telemetry": false,
    "breadcrumbs.filePath": "off",
    "aws.suppressPrompts": {
        "codeWhispererConnectionExpired": true
    },
    "task.allowAutomaticTasks": "on",
    "r.rterm.option": [
        "--no-save",
        "--no-restore",
        "--quiet"
    ],
    "r.lsp.debug": true,
    "r.lsp.use_stdio": true,
    "r.removeLeadingComments": true,
    "r.rmarkdown.knit.openOutputFile": true,
    "r.plot.defaults.plotPreviewLayout": "scroll",
