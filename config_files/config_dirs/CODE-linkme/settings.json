        // <!-- % "\\Cov": "\\operatorname{Cov} -->",
        "\\Cor": "\\operatorname{Cor}",
        "\\Var": "\\operatorname{Var}",
        "\\EW": "\\operatorname{\\dsE}",
        "\\D": "\\operatorname{D}",
        "\\Bias": "\\operatorname{Bias}",
        "\\MSE": "\\operatorname{MSE}",
        "\\PLS": "\\operatorname{PLS}",
        "\\rank": "\\operatorname{rank}",
        "\\ncol": "\\operatorname{ncol}",
        "\\pen": "\\operatorname{pen}",
        "\\const": "\\operatorname{const}",
        "\\diag": "\\operatorname{diag}",
